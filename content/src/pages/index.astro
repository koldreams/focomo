---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Focomo - 3D Focus Timer for iOS">
  <!-- Hero Section -->
  <section class="text-center py-16 border-b border-gray-200 mb-12">
    <h1 class="hero-title">Watch Your Focus Come to Life</h1>
    <p class="hero-description">
      Interactive 3D tomato timer that makes productivity visually rewarding. Tap, drag, and watch your progress ripen in real-time with beautiful 3D graphics.
    </p>
    <div class="mt-8">
      <a href="https://apps.apple.com/app/focomo" target="_blank" rel="noopener" class="btn-primary">
        Get Focomo - $4.99
      </a>
    </div>
  </section>

  <!-- What is Focomo -->
  <section class="mb-16">
    <h2 class="heading-secondary">What is Focomo?</h2>
    <div class="grid-2col">
      <div class="card-surface">
        <h3 class="text-xl font-semibold text-tomato-500 mb-4">🍅 Interactive 3D Timer</h3>
        <p class="text-gray-600 mb-4">Tap to start, drag to set time, watch your tomato ripen in real-time. Interactive 3D graphics make every focus session visually engaging and rewarding.</p>
      </div>

      <div class="card-surface">
        <h3 class="text-xl font-semibold text-tomato-500 mb-4">⚡ Beautiful Graphics</h3>
        <p class="text-gray-600 mb-4">Stunning 3D graphics deliver beautiful visuals. Every animation and interaction is crafted to make focus time enjoyable and motivating.</p>
      </div>

      <div class="card-surface">
        <h3 class="text-xl font-semibold text-tomato-500 mb-4">🎯 Focus Mode</h3>
        <p class="text-gray-600 mb-4">Automatic Do Not Disturb activation protects your sessions from interruptions, letting you dive deep into focused work.</p>
      </div>

      <div class="card-surface">
        <h3 class="text-xl font-semibold text-tomato-500 mb-4">📊 Visual Progress</h3>
        <p class="text-gray-600 mb-4">Watch your productivity take visual form as your tomato ripens. Real-time progress that's more engaging than traditional timers.</p>
      </div>
    </div>
  </section>

  <!-- How to Use -->
  <section class="mb-16">
    <h2 class="heading-secondary">How to Use Focomo</h2>
    <div class="card-surface">
      <ol class="space-y-4 text-gray-700">
        <li class="flex items-center">
          <span class="flex-shrink-0 w-8 h-8 bg-tomato-500 text-white rounded-full flex items-center justify-center text-sm font-semibold mr-4">1</span>
          <div>
            <strong>Tap the 3D tomato</strong> to start timer selection. Watch it spin and approach the camera.
          </div>
        </li>
        <li class="flex items-center">
          <span class="flex-shrink-0 w-8 h-8 bg-tomato-500 text-white rounded-full flex items-center justify-center text-sm font-semibold mr-4">2</span>
          <div>
            <strong>Drag the time scale</strong> to choose your focus duration (5 minutes to 2 hours).
          </div>
        </li>
        <li class="flex items-center">
          <span class="flex-shrink-0 w-8 h-8 bg-tomato-500 text-white rounded-full flex items-center justify-center text-sm font-semibold mr-4">3</span>
          <div>
            <strong>Tap to confirm</strong> and begin your session. Focus mode activates automatically.
          </div>
        </li>
        <li class="flex items-center">
          <span class="flex-shrink-0 w-8 h-8 bg-tomato-500 text-white rounded-full flex items-center justify-center text-sm font-semibold mr-4">4</span>
          <div>
            <strong>Watch your tomato ripen</strong> as you work. When time's up, enjoy the satisfying completion!
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Device Requirements -->
  <section class="mb-16">
    <h2 class="heading-secondary">Device Requirements</h2>
    <div class="card-surface">
      <ul class="space-y-3 text-gray-700">
        <li><strong>iOS 18.0 or later</strong> - Required for 3D graphics features</li>
        <li><strong>iPhone XS or newer</strong> - Optimized for modern devices</li>
      </ul>
    </div>
  </section>

  <!-- Privacy Policy -->
  <section class="mb-16">
    <h2 class="heading-secondary">Your Privacy</h2>
    <div class="card-surface">
      <div class="grid-2col">
        <div>
          <h3 class="text-xl font-semibold text-tomato-500 mb-4">🔒 No Data Collection</h3>
          <p class="text-gray-600 mb-4">Focomo does not collect, store, or transmit any personal information. All your focus session data stays private and secure on your device.</p>
        </div>
        
        <div>
          <h3 class="text-xl font-semibold text-tomato-500 mb-4">📱 Local Storage Only</h3>
          <p class="text-gray-600 mb-4">Your timer sessions and preferences are stored securely on your device. No account registration or personal information is required.</p>
        </div>
        
        <div>
          <h3 class="text-xl font-semibold text-tomato-500 mb-4">🚫 No Third-Party Tracking</h3>
          <p class="text-gray-600 mb-4">No analytics, advertising, or social media tracking. Focomo is completely free from third-party data collection.</p>
        </div>
        
        <div>
          <h3 class="text-xl font-semibold text-tomato-500 mb-4">🔓 Your Data, Your Control</h3>
          <p class="text-gray-600 mb-4">Access, view, or delete your focus session history anytime directly from the app. No external accounts or third-party services involved.</p>
        </div>
      </div>
      
      <div class="mt-6 p-4 bg-blue-50 border border-blue-200 rounded-custom">
        <p class="text-blue-700">
          <strong>Privacy Guarantee:</strong> Your focus data belongs to you. We never sell, share, or analyze your personal productivity information.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Get Support -->
  <section class="mb-16">
    <h2 class="heading-secondary">Need Help?</h2>
    <div class="card-surface">
      <p class="text-gray-700 mb-6">
        Having issues with Focomo or have ideas for improvements? We use GitHub Issues and Discussions for all community support and feedback.
      </p>
      
      <div class="grid-responsive">
        <div class="bg-red-50 border border-red-200 rounded-custom p-6 flex flex-col">
          <h3 class="text-lg font-semibold text-red-700 mb-3">🐛 Report a Bug</h3>
          <p class="text-gray-600 text-sm mb-4">Found something not working? Help us fix it!</p>
          <p class="text-gray-600 text-sm mb-4"><strong>Please include:</strong> iPhone model, iOS version, steps to reproduce</p>
          <a href="https://github.com/koldreams/focomo/issues/new?template=bug_report.md&labels=bug" target="_blank" rel="noopener" class="btn-primary m-t[auto]">
            Report Bug
          </a>
        </div>
        
        <div class="bg-blue-50 border border-blue-200 rounded-custom p-6 flex flex-col">
          <h3 class="text-lg font-semibold text-blue-700 mb-3">💡 Request Feature</h3>
          <p class="text-gray-600 text-sm mb-4">Have an idea to make Focomo better?</p>
          <p class="text-gray-600 text-sm mb-4"><strong>Tell us:</strong> What problem it solves, how it should work</p>
          <a href="https://github.com/koldreams/focomo/issues/new?template=feature_request.md&labels=enhancement" target="_blank" rel="noopener" class="btn-primary m-t[auto]">
            Suggest Feature
          </a>
        </div>

        <div class="bg-green-50 border border-green-200 rounded-custom p-6 flex-column flex flex-col">
          <h3 class="text-lg font-semibold text-green-700 mb-3">💬 General Discussion</h3>
          <p class="text-gray-600 text-sm mb-4">Questions, tips, or general feedback?</p>
          <p class="text-gray-600 text-sm mb-4"><strong>Perfect for:</strong> Usage questions, sharing tips, community chat</p>
          <a href="https://github.com/koldreams/focomo/discussions/new/choose" target="_blank" rel="noopener" class="btn-primary m-t[auto]">
            Start Discussion
          </a>
        </div>
      </div>

      <div class="mt-8 p-4 bg-gray-50 rounded-custom">
        <h4 class="font-semibold text-gray-800 mb-2">Support Process</h4>
        <ul class="text-sm text-gray-600 space-y-1 list-disc pl-4">
          <li>We typically respond within 1-2 business days</li>
          <li>Bug reports are prioritized by severity and device compatibility</li>
          <li>Feature requests are evaluated based on user demand and feasibility</li>
          <li>You'll receive updates on your issue through GitHub notifications</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>